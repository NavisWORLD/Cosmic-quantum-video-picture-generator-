# Core
# native = first-party COSMOS renderer
# procedural = tiny diagnostic renderer
# http = attach any external renderer/model stack
COSMOS_HOME=.cosmos-media
COSMOS_MEDIA_PROVIDER=native
COSMOS_MEDIA_ENDPOINT=http://127.0.0.1:9000
COSMOS_MEDIA_TIMEOUT=600
COSMOS_FFMPEG=ffmpeg
COSMOS_API_HOST=127.0.0.1
COSMOS_API_PORT=8788

# Prompt-driven editing
# cosmos-main = default composite identity using phera-ra/QC67_cosmo as controller/planner
# native-edit = offline Pillow/FFmpeg editor
# diffusers-edit = optional local semantic image editor + framewise semantic video orchestration
# http-edit = external semantic image/video editor bridge
COSMOS_DEFAULT_MODEL=cosmos-main
COSMOS_EDIT_RENDERER=native
# Optional overrides. Leave blank to inherit COSMOS_EDIT_RENDERER.
COSMOS_IMAGE_EDIT_RENDERER=
COSMOS_VIDEO_EDIT_RENDERER=
COSMOS_EDIT_ENDPOINT=
COSMOS_MAX_UPLOAD_MB=256

# Optional local semantic editor. Install first with:
#   pip install -e '.[semantic]'
# Qwen-Image-Edit-2511 is large (roughly 58 GB of model files), so it is not bundled.
COSMOS_SEMANTIC_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2511
COSMOS_SEMANTIC_DEVICE=auto
COSMOS_SEMANTIC_STEPS=24

# Quantum mode: local | ibm | off
COSMOS_QUANTUM_MODE=local
COSMOS_QUANTUM_STRICT=0
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND=
IBM_QUANTUM_SHOTS=256

# Generation defaults
COSMOS_WIDTH=1024
COSMOS_HEIGHT=576
COSMOS_FPS=24
COSMOS_CHUNK_SECONDS=8
COSMOS_BRANCHES=4
COSMOS_SEED_NAMESPACE=cosmos-media-v1
